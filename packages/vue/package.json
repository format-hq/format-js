{
	"name": "@format.dev/vue",
	"description": "Format PDF Vue SDK",
	"version": "0.1.0",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/format-hq/format-js.git",
		"directory": "packages/vue"
	},
	"type": "module",
	"main": "./dist/index.cjs",
	"module": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": {
				"import": "./dist/index.d.ts",
				"require": "./dist/index.d.cts"
			},
			"import": "./dist/index.js",
			"require": "./dist/index.cjs"
		},
		"./package.json": "./package.json"
	},
	"scripts": {
		"clean": "rimraf dist",
		"build": "tsdown",
		"dev": "tsdown --watch",
		"typecheck": "tsc -p tsconfig.json --noEmit"
	},
	"peerDependencies": {
		"vue": "^3.5.24"
	},
	"devDependencies": {
		"@vue/tsconfig": "^0.8.1",
		"rimraf": "^6.0.1",
		"tsdown": "catalog:",
		"typescript": "^5",
		"unplugin-vue": "^7.1.0",
		"vue": "^3.5.24",
		"vue-tsc": "^3.1.5"
	},
	"files": [
		"dist",
		"LICENSE"
	],
	"publishConfig": {
		"access": "public"
	},
	"sideEffects": false
}
