{
	"extends": "@vue/tsconfig/tsconfig.json",
	"include": ["env.d.ts", "src/**/*", "src/**/*.vue", "shims-vue.d.ts"],
	"compilerOptions": {
		"tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
		"target": "ES2020",
		"module": "ES2020",
		"moduleResolution": "bundler",
		"jsx": "preserve",
		"strict": true,
		"skipLibCheck": true,
		"noEmit": true,
		"baseUrl": ".",
		"paths": {
			"@/*": ["./src/*"]
		}
	}
}
