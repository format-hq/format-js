{
	"name": "@format.dev/react",
	"description": "Format PDF React SDK",
	"version": "0.1.0",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/format-hq/format-js.git",
		"directory": "packages/react"
	},
	"type": "module",
	"main": "./dist/index.cjs",
	"module": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": {
				"import": "./dist/index.d.ts",
				"require": "./dist/index.d.cts"
			},
			"import": "./dist/index.js",
			"require": "./dist/index.cjs"
		},
		"./package.json": "./package.json"
	},
	"scripts": {
		"clean": "rimraf dist",
		"dev": "tsdown --watch",
		"build": "NODE_ENV=production tsdown"
	},
	"peerDependencies": {
		"react": "^18 || ^19",
		"react-dom": "^18 || ^19"
	},
	"devDependencies": {
		"@types/react": "catalog:",
		"@types/react-dom": "catalog:",
		"rimraf": "catalog:",
		"tsdown": "catalog:",
		"typescript": "catalog:"
	},
	"files": [
		"dist",
		"LICENSE"
	],
	"publishConfig": {
		"access": "public"
	},
	"sideEffects": false
}
