{
	"name": "@format.dev/compile",
	"version": "0.1.0",
	"license": "MIT",
	"description": "Compile Format documents into renderers, without the Studio UI",
	"author": "the format.dev developers",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/format-hq/format-js.git",
		"directory": "packages/compile"
	},
	"type": "module",
	"module": "./dist/server/index.mjs",
	"exports": {
		".": {
			"types": "./dist/server/index.d.mts",
			"default": "./dist/server/index.mjs"
		},
		"./next": {
			"types": "./types/next.d.ts",
			"default": "./dist/server/integrations/nextjs/index.mjs"
		},
		"./vite": {
			"types": "./dist/server/integrations/unplugin/vite.d.mts",
			"default": "./dist/server/integrations/unplugin/vite.mjs"
		},
		"./rollup": {
			"types": "./dist/server/integrations/unplugin/rollup.d.mts",
			"default": "./dist/server/integrations/unplugin/rollup.mjs"
		},
		"./webpack": {
			"types": "./dist/server/integrations/unplugin/webpack.d.mts",
			"default": "./dist/server/integrations/unplugin/webpack.mjs"
		},
		"./esbuild": {
			"types": "./dist/server/integrations/unplugin/esbuild.d.mts",
			"default": "./dist/server/integrations/unplugin/esbuild.mjs"
		},
		"./server/*": {
			"types": "./dist/server/*.d.mts",
			"default": "./dist/server/*.mjs"
		},
		"./shared/*": {
			"types": "./dist/shared/*.d.mts",
			"default": "./dist/shared/*.mjs"
		},
		"./package.json": "./package.json"
	},
	"bin": {
		"format-compile": "./bin/format-compile"
	},
	"files": [
		"bin/**",
		"dist/**",
		"types/**",
		"LICENSE"
	],
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"clean": "rimraf dist",
		"prebundle": "tsx scripts/prebundle.ts",
		"build-node": "tsx scripts/build-node.ts",
		"build": "pnpm generate:schema && pnpm prebundle && pnpm build-node",
		"generate:schema": "tsx scripts/generate-config-schema.ts",
		"dev": "pnpm prebundle && concurrently --kill-others-on-fail --names prebundle,node --prefix-colors magenta,cyan \"tsx watch --include 'src/server/compile/adaptors/**' --include 'src/server/compile/create-renderer.ts' --include 'src/server/compile/sanitize-html.ts' --include 'src/server/compile/virtual-styles.ts' --include 'src/server/utils/standard-schema-validate.ts' scripts/prebundle.ts\" \"FMT_WATCH=true tsx watch --include 'src/**' --exclude 'src/server/compile/generated/**' scripts/build-node.ts\"",
		"typecheck": "tsc -p tsconfig.json --noEmit"
	},
	"dependencies": {
		"@babel/preset-react": "^7.28.5",
		"@babel/preset-typescript": "^7.28.5",
		"@format.dev/cli": "workspace:*",
		"@format.dev/types": "workspace:*",
		"@format.dev/utils": "workspace:*",
		"@format.dev/zip": "workspace:*",
		"@standard-schema/spec": "^1.1.0",
		"@tailwindcss/vite": "^4.1.18",
		"@vanilla-extract/vite-plugin": "^5.1.4",
		"@vitejs/plugin-vue": "^6.0.3",
		"@vitejs/plugin-vue-jsx": "^5.1.3",
		"@wyw-in-js/vite": "^2.1.0",
		"autoprefixer": "^10.4.23",
		"commander": "^14.0.2",
		"eta": "^3.5.0",
		"gradient-string": "^3.0.0",
		"hast-util-from-parse5": "^8.0.3",
		"parse5": "^8.0.0",
		"pluralize": "^8.0.0",
		"postcss": "^8.5.6",
		"postcss-import": "^16.1.1",
		"postcss-value-parser": "^4.2.0",
		"prettier": "^3.7.4",
		"rehype-parse": "^9.0.1",
		"rehype-sanitize": "^6.0.0",
		"rehype-stringify": "^10.0.1",
		"rolldown": "1.0.0-beta.59",
		"sass-embedded": "^1.97.2",
		"semver": "^7.7.3",
		"unified": "^11.0.5",
		"unplugin": "^2.3.11",
		"vite": "npm:rolldown-vite@7.3.1",
		"vite-plugin-svgr": "^4.5.0",
		"vite-svg-loader": "^5.1.0"
	},
	"devDependencies": {
		"@pandacss/dev": "^1.8.0",
		"@types/express": "^5.0.6",
		"@types/jsdom": "^28.0.3",
		"@types/node": "^24.10.4",
		"@types/pluralize": "^0.0.33",
		"@types/postcss-import": "^14.0.3",
		"@types/react": "catalog:",
		"@types/react-dom": "catalog:",
		"@types/semver": "^7.7.1",
		"@vitest/browser-playwright": "^4.0.18",
		"concurrently": "^9.2.1",
		"execa": "^9.6.1",
		"express": "^5.2.1",
		"fflate": "^0.8.2",
		"get-port": "^7.1.0",
		"jsdom": "^26.1.0",
		"node-fetch": "^3.3.2",
		"playwright": "^1.58.2",
		"react": "catalog:",
		"react-dom": "catalog:",
		"rimraf": "catalog:",
		"ts-json-schema-generator": "^2.9.0",
		"tsdown": "catalog:",
		"tsx": "^4.21.0",
		"typescript": "catalog:",
		"unplugin-raw": "^0.6.4",
		"vitest": "^4.0.18",
		"vue": "catalog:"
	},
	"peerDependencies": {
		"@pandacss/dev": "^1.0.0"
	},
	"peerDependenciesMeta": {
		"@pandacss/dev": {
			"optional": true
		}
	},
	"engines": {
		"node": ">=22.12.0"
	}
}
