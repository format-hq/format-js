{
	"name": "@format.dev/client",
	"version": "0.1.0",
	"license": "MIT",
	"description": "The JavaScript client for the Format API.",
	"author": "the format.dev developers",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/format-hq/format-js.git",
		"directory": "packages/client"
	},
	"type": "module",
	"main": "./dist/index.cjs",
	"module": "./dist/index.mjs",
	"types": "./dist/index.d.mts",
	"exports": {
		".": {
			"types": {
				"import": "./dist/index.d.mts",
				"require": "./dist/index.d.cts"
			},
			"import": "./dist/index.mjs",
			"require": "./dist/index.cjs",
			"default": "./dist/index.mjs"
		}
	},
	"files": [
		"dist",
		"LICENSE"
	],
	"publishConfig": {
		"access": "public"
	},
	"sideEffects": false,
	"scripts": {
		"clean": "rimraf dist",
		"build": "tsdown",
		"dev": "tsdown --watch",
		"typecheck": "tsc -p tsconfig.json --noEmit"
	},
	"dependencies": {
		"@format.dev/types": "workspace:*",
		"form-data-encoder": "^4.1.0",
		"formdata-node": "^6.0.3",
		"is-stream": "^4.0.1"
	},
	"devDependencies": {
		"@types/node": "^24.2.1",
		"rimraf": "^6.0.1",
		"tsdown": "0.17.0-beta.6",
		"typescript": "^5"
	},
	"engines": {
		"node": ">=18.17.0"
	}
}
