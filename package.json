{
	"name": "format-js",
	"description": "the public source of the Format SDKs",
	"private": true,
	"type": "module",
	"packageManager": "pnpm@11.10.0",
	"engines": {
		"node": ">=22.18"
	},
	"scripts": {
		"build": "pnpm -r build",
		"typecheck:release": "tsc -p build/release/tsconfig.json --noEmit && tsc -p build/publish/tsconfig.json --noEmit",
		"check:packages": "node build/publish/cli.ts check"
	},
	"devDependencies": {
		"@arethetypeswrong/cli": "0.18.5",
		"@types/node": "^24.10.4",
		"publint": "0.3.23",
		"typescript": "catalog:"
	}
}
