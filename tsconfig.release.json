{
	"compilerOptions": {
		"target": "es2022",
		"lib": ["ES2022"],
		"skipLibCheck": true,
		"strict": true,
		"noEmit": true,
		"module": "NodeNext",
		"moduleResolution": "NodeNext",
		"types": ["node"],
		"resolveJsonModule": true,
		"allowImportingTsExtensions": true,
		"allowJs": true
	},
	"include": ["build/release", "build/publish"],
	"exclude": ["**/node_modules"]
}
